# EH3D-NODE-BUNGARD-HMI settings: copy to hmi.cfg in the config partition. Every value is optional; the defaults are the safe ones.
# en es it de fr pt zh ja bg hr cs da nl et fi el hu ga lv lt mt pl ro sk sl sv no is uk ru sr sq ca gl eu pt-br fr-ca
language = en
theme = forge
# auto, landscape (1280 x 800) or portrait (800 x 1280)
orientation = auto
# 10..100
brightness_percent = 80
# 0 never
idle_dim_s = 120

# the EH3D server that moves the machine; empty = nothing is controlled
server_host =
server_port = 18200
server_machine =
# how often the fleet is read, 1..60 seconds
poll_s = 3
# the table of the machine, for the warning of a board that does not fit (0 = the one the server says: the course of the machine less the offset)
table_width_mm = 0
# used only when the server does not say it; 0..5000
table_depth_mm = 0
# write-only, 8..64 characters
token =

# the safety switches (every default is the conservative one)
# a move or a spindle order asks for a confirmation on the screen
confirm_moves = on
# 1000..60000
confirm_timeout_ms = 8000
# 1..200
jog_max_mm = 20
# 0 = the screen never starts the spindle
spindle_max_rpm = 24000
# the turns the spindle button asks for (0 = the speed the job says); the gate cuts it to what the spindle of the machine gives
spindle_rpm = 12000
# an order for more turns than the spindle gives: clip (cut to its top speed and say so) or refuse
spindle_over = clip
# control the machine only while the hardware stop input is wired and released
hw_stop_required = on
# 200..60000
link_idle_ms = 3000
# the data shown are marked old when the server has not updated them for this many seconds, 2..3600
stale_after_s = 15
# the machine page says the model, the tool at work with its holes (cuts) done, the next tool, the tools finished and the time left
tool_bar = on

# voice
voice_alerts = on
# spoken orders; a spoken order always asks for a confirmation
voice_orders = off
# on: a spoken "yes" confirms; off: only a touch does
voice_confirm = off
volume_percent = 60
mic_gain_percent = 50

# the notices: off, default (the tone) or a recorded voice in the folder voices of the card: voice:LANG:f (female) or voice:LANG:m (male); LANG is en, es, it, de, fr, pt, zh or ja
sound_finish = off
sound_tool_change = off
# the visual check of the board with the camera of the drill head: the notice when it is correct and when it is not correct (a voice says: the visual check of the board is correct / is not correct)
sound_check_ok = off
sound_check_bad = off
# the drilling is done and the routing comes next (the recording is voices/LANG/f|m/stage.wav)
sound_stage = off

# the panel that moves the machine by hand
# the distances of the step buttons, mm, from the finest to the coarsest: up to 8, increasing, each above 0 and up to 500
jog_steps = 0.01, 0.1, 1, 10, 50
# the step chosen when the panel opens (one of the list, or the nearest to it)
jog_step = 1
# on: an arrow moves the head for as long as it is held (a stretch at a time); off: one step for each press
jog_continuous = off
# the three speeds, mm per minute, 1..20000, and the one chosen when the panel opens: slow, medium or fast
jog_speed_slow = 300
jog_speed_medium = 1200
jog_speed_fast = 3000
jog_speed = medium
# a held arrow moves the head in stretches of this length, mm, 0.1..20
jog_chunk_mm = 2
# the head crosses the board only when it is at least this far above its surface, mm, 0..100; lower than that, Z goes up first
jog_clearance_mm = 5
# how far below home the surface of the board is, mm, 0..500 (0 = not known: Z does not move by hand)
jog_board_z_mm = 0
# how far below the surface the tool may go by hand, mm, 0..50
jog_below_board_mm = 0
# the safety switches of the panel (every default is the conservative one)
# no move by hand while a job runs or waits (the hardware stop always blocks it)
jog_block_running = on
# the head stays inside the table and above the board; a move that would pass the end goes to the end
jog_limits = on
# Z goes up to the clearance before the head crosses the board
jog_safe_z = on

# the bar of the tool changer (only on a machine whose model says ATC)
# the places of the bar the machine defines: 1 to 14, like 1-14 or 1,2,5-8
rack_places = 1-14
# a job does not start while a tool has no place, a place is not defined or two tools share one
rack_check = on
# the request of the job carries the places of the tools and the chaining of the drilling and the routing (a server that does not know them gets the job without)
rack_chain = on
# the window that says the drilling is done and the routing comes next, with the buttons to follow the routing or to stop
stage_window = on
# the local time of the hour a job is expected to end at, minutes from UTC, -720..840 (the chip has no time zones)
clock_utc_offset_min = 0
