# EH3D-NODE-BUNGARD-HMI settings: copy to hmi.cfg in the config partition. Every value is optional; the defaults are the safe ones.
language = en              # en es it de fr pt zh ja bg hr cs da nl et fi el hu ga lv lt mt pl ro sk sl sv no is uk ru sr sq ca gl eu pt-br fr-ca
theme = forge
orientation = auto         # auto, landscape (1280 x 800) or portrait (800 x 1280)
brightness_percent = 80    # 10..100
idle_dim_s = 120           # 0 never

server_host =              # the EH3D server that moves the machine; empty = nothing is controlled
server_port = 18200
server_machine =
poll_s = 3                 # how often the fleet is read, 1..60 seconds
table_width_mm = 0         # the table of the machine, for the warning of a board that does not fit (0 = the one the server says: the course of the machine less the offset)
table_depth_mm = 0         # used only when the server does not say it; 0..5000
token =                    # write-only, 8..64 characters

# the safety switches (every default is the conservative one)
confirm_moves = on         # a move or a spindle order asks for a confirmation on the screen
confirm_timeout_ms = 8000  # 1000..60000
jog_max_mm = 20            # 1..200
spindle_max_rpm = 24000    # 0 = the screen never starts the spindle
spindle_rpm = 12000        # the turns the spindle button asks for (0 = the speed the job says); the gate cuts it to what the spindle of the machine gives
spindle_over = clip        # an order for more turns than the spindle gives: clip (cut to its top speed and say so) or refuse
hw_stop_required = on      # control the machine only while the hardware stop input is wired and released
link_idle_ms = 3000        # 200..60000

# voice
voice_alerts = on
voice_orders = off         # spoken orders; a spoken order always asks for a confirmation
voice_confirm = off        # on: a spoken "yes" confirms; off: only a touch does
volume_percent = 60
mic_gain_percent = 50

# the notices: off, default (the tone) or a recorded voice in the folder voices of the card: voice:LANG:f (female) or voice:LANG:m (male); LANG is en, es, it, de, fr, pt, zh or ja
sound_finish = off
sound_tool_change = off
# the visual check of the board with the camera of the drill head: the notice when it is correct and when it is not correct (a voice says: the visual check of the board is correct / is not correct)
sound_check_ok = off
sound_check_bad = off
