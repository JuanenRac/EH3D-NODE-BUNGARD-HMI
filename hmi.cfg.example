# EH3D-NODE-BUNGARD-HMI settings: copy to hmi.cfg in the config partition. Every value is optional; the defaults are the safe ones.
language = en              # en es it de fr pt zh ja
theme = forge
brightness_percent = 80    # 10..100
idle_dim_s = 120           # 0 never

server_host =              # the EH3D server or node that moves the machine; empty = nothing is controlled
server_port = 8080
server_machine =
token =                    # write-only, 8..64 characters

# the safety switches (every default is the conservative one)
confirm_moves = on         # a move or a spindle order asks for a confirmation on the screen
confirm_timeout_ms = 8000  # 1000..60000
jog_max_mm = 20            # 1..200
spindle_max_rpm = 24000    # 0 = the screen never starts the spindle
hw_stop_required = on      # control the machine only while the hardware stop input is wired and released
link_idle_ms = 3000        # 200..60000

# voice
voice_alerts = on
voice_orders = off         # spoken orders; a spoken order always asks for a confirmation
voice_confirm = off        # on: a spoken "yes" confirms; off: only a touch does
volume_percent = 60
mic_gain_percent = 50
